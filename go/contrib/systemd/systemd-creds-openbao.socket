[Unit]
Description=OpenBao credential socket for systemd services
Documentation=https://github.com/kranzes/systemd-creds-openbao

[Socket]
ListenStream=/run/systemd-creds-openbao.sock
# Credentials are fetched by the service manager (root); nobody else needs
# to talk to this socket.
SocketMode=0600
SocketUser=root
SocketGroup=root
RemoveOnStop=yes

[Install]
WantedBy=sockets.target

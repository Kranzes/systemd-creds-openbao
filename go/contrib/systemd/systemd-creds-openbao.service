[Unit]
Description=OpenBao credential provider for systemd services
Documentation=https://github.com/kranzes/systemd-creds-openbao
Requires=systemd-creds-openbao.socket
After=systemd-creds-openbao.socket network-online.target
Wants=network-online.target

[Service]
# The daemon is only ready once it has authenticated to OpenBao, and it
# re-reads its configuration on SIGHUP, which is what `systemctl reload`
# sends.
Type=notify-reload
ExecStart=systemd-creds-openbao -config /etc/systemd-creds-openbao/config.toml
# A login that fails on an outage (OpenBao down, sealed, unreachable) is
# retried in process for as long as it takes, and staying in activating
# is what lets consumers order after the service. The same setting would
# also time reloads, which the daemon bounds itself, backed by the watchdog.
TimeoutStartSec=infinity
# When OpenBao rejects a login outright the daemon exits, and the next start
# re-reads the credential, so a corrected one is picked up on its own. The
# backoff keeps a wrong one from hitting the login endpoint every 2s, and
# the daemon resets it with RESTART_RESET=1 once ready, so it grows across
# consecutive failed starts only.
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=1min

# Re-provision LoadCredential= before the reload, so the daemon's own
# rotated token file is what it re-authenticates with.
RefreshOnReload=credentials

# A reload pings the watchdog only at its start and end, up to 35 seconds
# apart, so this must stay above 35s. The daemon warns at startup when it
# is not.
WatchdogSec=1min

DynamicUser=yes

ConfigurationDirectory=systemd-creds-openbao

CapabilityBoundingSet=
# Core dumps and swap could write secret material to disk.
LimitCORE=0
MemorySwapMax=0
MemoryZSwapMax=0
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
# The identity mapping keeps SO_PEERCRED uids meaningful. The daemon's
# peer-trust check relies on them.
PrivateUsers=identity
ProcSubset=pid
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
# AF_NETLINK is needed for getaddrinfo in cgo-built binaries.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077
